# DoseMinder Environment Variables Template
# Copy this file to .env.local and fill in the values

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Project URL from Supabase dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service role key (CRITICAL: Server-only! Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# -----------------------------------------------------------------------------
# Web Push (VAPID) Keys
# -----------------------------------------------------------------------------
# Generate using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@doseminder.app

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=DoseMinder <notifications@yourdomain.com>

# -----------------------------------------------------------------------------
# Google Gemini API (AI Prescription & Drug Info Translation)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Application & Security Settings
# -----------------------------------------------------------------------------
# Public canonical URL (http://localhost:3000 for local dev)
APP_URL=http://localhost:3000

# Shared secret for pg_cron -> Edge function calls
CRON_SHARED_SECRET=your-secure-random-token-here

# Seed script protection (refuses to run unless explicitly true in non-production)
ALLOW_SEED=false
